{
  "version": 6,
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native (GCC 16.2, Qt 6.12 + backend libraries in ../toolchain-cpp)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "${sourceParentDir}/toolchain-cpp/software/gcc-16.2.0/bin/g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "${sourceParentDir}/toolchain-cpp/software/Qt/6.12.0/gcc_64;${sourceParentDir}/toolchain-cpp/software/libpqxx-8.0.2;${sourceParentDir}/toolchain-cpp/software/cpp-httplib-0.61.0;${sourceParentDir}/toolchain-cpp/software/protobuf-36.2;${sourceParentDir}/toolchain-cpp/software/buf-1.74.0"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly (Qt 6.12 wasm_singlethread + emsdk 5.0.5)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "${sourceParentDir}/toolchain-cpp/software/Qt/6.12.0/wasm_singlethread/lib/cmake/Qt6/qt.toolchain.cmake",
      "environment": {
        "EMSDK": "${sourceParentDir}/toolchain-cpp/software/emsdk",
        "EMSDK_PYTHON": "$env{HOME}/.local/bin/python3.12"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QT_HOST_PATH": "${sourceParentDir}/toolchain-cpp/software/Qt/6.12.0/gcc_64",
        "CMAKE_PREFIX_PATH": "${sourceParentDir}/toolchain-cpp/software/protobuf-36.2-wasm",
        "CMAKE_FIND_ROOT_PATH": "${sourceParentDir}/toolchain-cpp/software/protobuf-36.2-wasm",
        "GUITA_HOST_PROTOBUF_DIR": "${sourceParentDir}/toolchain-cpp/software/protobuf-36.2"
      }
    },
    {
      "name": "static",
      "displayName": "Self-contained desktop client (GCC 16.2, static Qt 6.12 and libpq in ../toolchain-cpp)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/static",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "${sourceParentDir}/toolchain-cpp/software/gcc-16.2.0/bin/g++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceParentDir}/toolchain-cpp/software/Qt/6.12.0-static;${sourceParentDir}/toolchain-cpp/software/libpq-18.6-static;${sourceParentDir}/toolchain-cpp/software/libpqxx-8.0.2;${sourceParentDir}/toolchain-cpp/software/cpp-httplib-0.61.0;${sourceParentDir}/toolchain-cpp/software/protobuf-36.2",
        "GUITA_STATIC": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "bench",
      "displayName": "Measurements (native, Release)",
      "inherits": "native",
      "binaryDir": "${sourceDir}/build/bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GUITA_BENCH": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "wasm-bench",
      "displayName": "Measurements (WebAssembly, Release)",
      "inherits": "wasm",
      "binaryDir": "${sourceDir}/build/wasm-bench",
      "cacheVariables": {
        "GUITA_BENCH": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "wasm",
      "configurePreset": "wasm"
    },
    {
      "name": "static",
      "configurePreset": "static",
      "targets": [
        "client"
      ]
    },
    {
      "name": "bench",
      "configurePreset": "bench",
      "targets": [
        "bench_encoding",
        "bench_latency"
      ]
    },
    {
      "name": "wasm-bench",
      "configurePreset": "wasm-bench",
      "targets": [
        "bench_encoding"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
